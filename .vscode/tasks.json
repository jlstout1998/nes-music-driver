{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Assemble NES",
            "type": "shell",
            "command": "ca65",
            "args": [
                "main.asm",
                "-o",
                "main.o"
            ],
            "problemMatcher": {
                "owner": "ca65",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(Error|Warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Link NES ROM",
            "type": "shell",
            "command": "ld65",
            "args": [
                "-C",
                "nes.cfg",
                "-o",
                "MusicDriver.nes",
                "main.o"
            ],
            "dependsOn": "Assemble NES",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build NES",
            "dependsOn": "Link NES ROM",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run NES ROM",
            "type": "shell",
            "command": "D:\\Program Files\\FCEUX\\fceux64.exe",
            "args": [
                "${workspaceFolder}\\MusicDriver.nes"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build and Run NES",
            "dependsOn": [
                "Build NES",
                "Run NES ROM"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}